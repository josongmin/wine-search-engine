NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# HTTP rate limit (per IP / minute). Use 0 to disable locally; raise for offline eval bursts.
HTTP_RATE_LIMIT_MAX=100

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=wine_engine
PG_USER=wine
PG_PASSWORD=wine_secret

# Redis
REDIS_URL=redis://localhost:6379

# Vespa
VESPA_URL=http://localhost:8080
VESPA_CONTENT_CLUSTER=wine_content

# Embedding Service
EMBEDDING_SERVICE_URL=http://localhost:8081
EMBEDDING_MODEL=bge-m3

# Reranker Service
RERANKER_SERVICE_URL=http://localhost:8082
# Multiplies query-class rerank blend weights (0–1). Lower = less cross-encoder influence.
RERANK_BLEND_SCALE=0.7

# Kill Switch
KILL_SWITCH_ALIAS_OVERLAY=false
KILL_SWITCH_LEARNING=false
KILL_SWITCH_DENSE_RETRIEVAL=false
