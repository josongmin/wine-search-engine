NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# HTTP rate limit (per IP / minute). Use 0 to disable locally; raise for offline eval bursts.
HTTP_RATE_LIMIT_MAX=100
# Trust X-Forwarded-* when behind a reverse proxy / load balancer (affects client IP and rate-limit key).
HTTP_TRUST_PROXY=false
# Max JSON request body size in bytes (Fastify bodyLimit). Default 1 MiB; max 32 MiB in schema.
HTTP_BODY_LIMIT_BYTES=1048576
# Register @fastify/helmet security headers (disable only for narrow local debugging).
HTTP_SECURITY_HEADERS=true
# Comma-separated allowlist. Empty string keeps local/dev defaults.
CORS_ALLOWED_ORIGINS=
# Fire-and-forget startup eval lane. Keep false for local bootstrap.
EVAL_RUN_AT_STARTUP=false

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=wine_engine
PG_USER=wine
PG_PASSWORD=wine_secret
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379

# Shared local data dir. Scripts/tests prefer this path; otherwise they auto-fallback
# to ~/.wine-search-engine/data when it exists, then finally to ./data.
# WINE_DATA_DIR=/Users/yourname/.wine-search-engine/data
# Shared local build artifact dir. Generated dist/.next/tsbuildinfo files can live here.
# WINE_BUILD_DIR=/Users/yourname/.wine-search-engine/build
# Shared local dependency dir. Root node_modules can live here via symlink.
# web/node_modules stays repo-local because Next/Turbopack rejects out-of-root symlinks.
# WINE_DEPS_DIR=/Users/yourname/.wine-search-engine/deps

# Watchlist
WATCHLIST_ENABLED=false
# WEBHOOK_SECRET=watchlist-secret-1234

# Vespa
VESPA_URL=http://localhost:8080
VESPA_CONTENT_CLUSTER=wine_content

# Embedding Service (HTTP, OpenAI-compatible `/embeddings` — no Bearer by default)
EMBEDDING_SERVICE_URL=http://localhost:8081
EMBEDDING_MODEL=bge-m3
EMBEDDING_HTTP_TIMEOUT_MS=30000

# OpenAI (optional — hexagonal ChatLlmPort on container; optional embedding override)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# When set with OPENAI_API_KEY, dense retrieval uses OpenAI embeddings instead of EMBEDDING_SERVICE_URL:
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_HTTP_TIMEOUT_MS=120000

# External reranker API (optional) — omit to disable reranking entirely
# RERANKER_SERVICE_URL=https://your-reranker-provider.example.com
# Cohere managed reranker (preferred) — set API key to enable
# COHERE_API_KEY=...
COHERE_RERANK_MODEL=rerank-v4.0-pro
# COHERE_BASE_URL=https://api.cohere.ai/v2
# Multiplies query-class rerank blend weights (0–1). Lower = less cross-encoder influence.
RERANK_BLEND_SCALE=0.7
RERANKER_HTTP_TIMEOUT_MS=30000

# Learned matcher (optional RFC-006 §5.2) — omit URL to disable
# LEARNED_MATCHER_SERVICE_URL=http://localhost:8083
LEARNED_MATCHER_HTTP_TIMEOUT_MS=30000

# Anthropic (optional) — enables Layer 2 LLM prompt-injection judge when set
# ANTHROPIC_API_KEY=
# ANTHROPIC_INJECTION_MODEL=claude-haiku-4-5-20251001
INJECTION_JUDGE_FAIL_OPEN=false

# Drinking window (optional) — omit model dir to allow heuristic-only local fallback
ALLOW_HEURISTIC_DRINKING_WINDOW=false
# DRINKING_WINDOW_MODEL_DIR=/absolute/path/to/drinking-window-model

# Confidence refusal (optional) — unset keeps legacy no-threshold behavior
# CONFIDENCE_REFUSAL_THRESHOLD=0.45

# Kill Switch
KILL_SWITCH_ALIAS_OVERLAY=false
KILL_SWITCH_LEARNING=false
KILL_SWITCH_DENSE_RETRIEVAL=false
KILL_SWITCH_INJECTION_JUDGE=false
KILL_SWITCH_QUERY_CACHE=false
