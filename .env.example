NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# HTTP rate limit (per IP / minute). Use 0 to disable locally; raise for offline eval bursts.
HTTP_RATE_LIMIT_MAX=100
# Trust X-Forwarded-* when behind a reverse proxy / load balancer (affects client IP and rate-limit key).
HTTP_TRUST_PROXY=false
# Max JSON request body size in bytes (Fastify bodyLimit). Default 1 MiB; max 32 MiB in schema.
HTTP_BODY_LIMIT_BYTES=1048576
# Register @fastify/helmet security headers (disable only for narrow local debugging).
HTTP_SECURITY_HEADERS=true

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=wine_engine
PG_USER=wine
PG_PASSWORD=wine_secret
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379

# Watchlist
WATCHLIST_ENABLED=false
WEBHOOK_SECRET=
PG_TEST_URL=postgresql://wine:wine_test@localhost:5433/wine_engine_test

# Vespa
VESPA_URL=http://localhost:8080
VESPA_CONTENT_CLUSTER=wine_content

# Embedding Service
EMBEDDING_SERVICE_URL=http://localhost:8081
EMBEDDING_MODEL=bge-m3
EMBEDDING_HTTP_TIMEOUT_MS=30000

# Reranker Service
RERANKER_SERVICE_URL=http://localhost:8082
# Multiplies query-class rerank blend weights (0–1). Lower = less cross-encoder influence.
RERANK_BLEND_SCALE=0.7
RERANKER_HTTP_TIMEOUT_MS=30000

# Learned matcher (optional RFC-006 §5.2) — omit URL to disable
# LEARNED_MATCHER_SERVICE_URL=http://localhost:8083
LEARNED_MATCHER_HTTP_TIMEOUT_MS=30000

# Anthropic (optional) — enables Layer 2 LLM prompt-injection judge when set
# ANTHROPIC_API_KEY=
# ANTHROPIC_INJECTION_MODEL=claude-haiku-4-5-20251001
# INJECTION_JUDGE_FAIL_OPEN=false

# Kill Switch
KILL_SWITCH_ALIAS_OVERLAY=false
KILL_SWITCH_LEARNING=false
KILL_SWITCH_DENSE_RETRIEVAL=false
KILL_SWITCH_INJECTION_JUDGE=false
KILL_SWITCH_QUERY_CACHE=false
