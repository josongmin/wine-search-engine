# Claude Code — personal overrides (team shares .claude/settings.json)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Codex — optional local overrides next to project config
.codex/config.local.toml

# AI tooling — caches / generated dirs (Cursor, Codex, Claude Code)
.cursor/cache/
.cursor/debug/
.cursor/browser-logs/
.codex/cache/
.codex/sessions/
.claude/debug/
.claude/cache/
.claude/sessions/

# Vitest / test artifacts
test-results
test-results/
playwright-report
playwright-report/

# Benchmark run artifacts (per-run results + logs).
# The committed baseline.json is whitelisted below for regression gating.
test/benchmark/agent/results/*.json
test/benchmark/agent/results/*.log
test/benchmark/agent/results/*.txt
!test/benchmark/agent/results/baseline.json
!test/benchmark/agent/results/.gitkeep

# Linked build outputs in nested workspaces
web/.next
web/next-env.d.ts

# Compressed archives & local snapshots (do not commit dumps / code-audit bundles)
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tgz
*.zip
*.7z
*.rar

