{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo.build",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "files": ["src/main.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/lambdamart-ranker.ts",
    "**/ltr-ranker.ts",
    "**/ltr-training-service.ts"
  ]
}
