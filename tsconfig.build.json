{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo.build",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false,
    "declarationMap": false
  },
  "files": ["src/main.ts"],
  "exclude": ["node_modules", "dist", "test", "**/__tests__/**", "**/*.test.ts", "**/lambdamart-ranker.ts", "**/ltr-ranker.ts", "**/ltr-training-service.ts"]
}
