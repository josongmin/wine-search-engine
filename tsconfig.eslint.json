{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "config/vitest/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
