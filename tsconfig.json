{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": ".tsbuildcache/root",
    "tsBuildInfoFile": ".tsbuildcache/root/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "src/domain/**",
    "src/**/__tests__/**",
    "src/__tests__/**",
    "**/*.test.ts"
  ],
  "references": [
    { "path": "./src/domain/shared" },
    { "path": "./src/domain" }
  ]
}
