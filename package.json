{
  "name": "wine-search-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wine": "dist/interface/cli/main.js"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm-install.mjs",
    "deps:link": "bash scripts/deps/link-external-node-modules.sh",
    "artifacts:link": "bash scripts/build/link-external-artifacts.sh",
    "clean:worktree": "bash scripts/build/clean-worktree-artifacts.sh",
    "deadcode": "knip --no-exit-code",
    "deadcode:ratchet": "node scripts/knip-ratchet.mjs",
    "deadcode:ratchet:update": "node scripts/knip-ratchet.mjs --update",
    "dev": "tsx watch src/main.ts",
    "build": "pnpm run artifacts:link && tsc --project tsconfig.build.json --pretty false",
    "cli": "tsx src/interface/cli/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --config config/vitest/dev.config.ts",
    "test:watch": "vitest --config config/vitest/dev.config.ts",
    "test:dev": "vitest run --config config/vitest/dev.config.ts",
    "test:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/dev.config.ts",
    "test:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/dev.config.ts",
    "test:eval": "vitest run --config config/vitest/eval.config.ts",
    "test:eval:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/eval.config.ts",
    "test:meta": "vitest run --config config/vitest/meta.config.ts",
    "test:meta:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/meta.config.ts",
    "test:unit": "vitest run --config config/vitest/unit.config.ts",
    "test:unit:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/unit.config.ts",
    "test:unit:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/unit.config.ts",
    "test:heavy": "vitest run --config config/vitest/heavy.config.ts",
    "test:network": "vitest run --config config/vitest/network.config.ts",
    "test:coverage": "pnpm run artifacts:link && mkdir -p coverage/.tmp && vitest run --config config/vitest/unit.config.ts --coverage",
    "test:integration": "vitest run --config config/vitest/integration.config.ts",
    "test:integration:cutover": "vitest run test/integration/etl/cutover-namespace-seal.integration.test.ts --config config/vitest/integration.config.ts",
    "test:integration:curation": "vitest run test/integration/curation/pg-curation-store.integration.test.ts --config config/vitest/integration.config.ts",
    "test:integration:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/integration.config.ts",
    "test:integration:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/integration.config.ts",
    "test:integration:search-pipeline": "vitest run --config config/vitest/integration.search-pipeline.config.ts",
    "test:e2e": "pnpm run test:e2e:contract",
    "test:e2e:fast": "pnpm run test:e2e:contract",
    "test:e2e:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/e2e.config.ts",
    "test:e2e:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/e2e.config.ts",
    "test:e2e:runtime": "vitest run --config config/vitest/e2e.runtime.config.ts",
    "test:e2e:inmemory": "vitest run --config config/vitest/e2e.config.ts",
    "test:e2e:contract": "vitest run --config config/vitest/e2e.smoke.config.ts",
    "test:e2e:smoke": "pnpm run test:e2e:contract",
    "test:e2e:full": "pnpm run test:e2e:contract && pnpm run test:e2e:runtime && pnpm run test:e2e:inmemory",
    "test:e2e:replay:fixtures:self-contained": "vitest run --config config/vitest/e2e.replay.config.ts",
    "test:e2e:replay:fixtures:runtime-required": "vitest run test/e2e/search-replay-runtime-required-fixtures.test.ts --config config/vitest/e2e.replay.config.ts",
    "test:e2e:replay:fixtures:full-runtime": "bash scripts/run-vespa-test-lane.sh npx vitest run test/e2e/vespa/search-replay-full-runtime-fixtures.test.ts --config config/vitest/e2e.vespa.config.ts",
    "test:e2e:replay:fixtures:full-runtime:debug": "bash scripts/run-vespa-test-lane.sh npx vitest run test/e2e/vespa/search-replay-full-runtime-fixtures.test.ts --config config/vitest/e2e.vespa.config.ts --reporter=verbose",
    "test:e2e:vespa": "pnpm run test:e2e:vespa:full",
    "test:e2e:vespa:smoke": "bash scripts/run-vespa-test-lane.sh npx vitest run --config config/vitest/e2e.vespa.smoke.config.ts --reporter=verbose",
    "test:e2e:vespa:smoke:dev": "VESPA_URL=http://localhost:8080 npx vitest run --config config/vitest/e2e.vespa.smoke.config.ts --reporter=verbose",
    "test:e2e:vespa:full": "bash scripts/run-vespa-e2e.sh",
    "test:e2e:vespa:setup": "bash scripts/setup-vespa-test.sh",
    "test:e2e:vespa:teardown": "bash scripts/teardown-vespa-test.sh",
    "test:e2e:vespa:only": "bash scripts/run-vespa-test-lane.sh npx vitest --config config/vitest/e2e.vespa.config.ts --reporter=verbose",
    "test:e2e:vespa:network": "bash scripts/run-vespa-test-lane.sh npx vitest run test/e2e/vespa/search-network-services.test.ts --config config/vitest/e2e.vespa.config.ts --reporter=verbose",
    "test:ingest:contract": "vitest run --config config/vitest/ingest.contract.config.ts",
    "test:ingest:indexing": "bash scripts/run-vespa-test-lane.sh npx tsx scripts/etl/run-ingest-indexing-smoke.ts",
    "test:quality": "vitest run --config config/vitest/quality.config.ts && pnpm run test:verification:noisy",
    "test:quality:nightly": "pnpm run test:quality",
    "test:quality:vespa": "bash scripts/run-vespa-test-lane.sh npx vitest run --config config/vitest/quality.vespa.config.ts",
    "bench:smoke": "pnpm run test:file -- test/benchmark/agent/__tests__/",
    "bench:agent:export-scenarios-md": "tsx scripts/benchmark/export-agent-scenarios-md.ts",
    "benchmark:messy:entity": "node --import tsx scripts/eval/run-noisy-entity-eval.ts --output /tmp/noisy-entity-live-results.json --mode hybrid",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:meta && pnpm run test:e2e:contract && pnpm run test:ingest:contract && pnpm run test:quality",
    "test:all:full": "pnpm run test:all && pnpm run test:heavy && pnpm run test:e2e:runtime",
    "test:verification:vespa": "bash scripts/run-vespa-verification.sh",
    "lint": "eslint .",
    "lint:file": "node scripts/test/run-eslint.mjs",
    "lint:file:fix": "node scripts/test/run-eslint.mjs --fix --max-warnings=0",
    "lint:smart": "node scripts/test/lint-smart.mjs",
    "lint:staged": "node scripts/test/lint-smart.mjs --staged",
    "lint:fix": "eslint . --fix",
    "semgrep": "semgrep scan --metrics=off --config=semgrep/wine-rules.yml --config=p/ci --config=p/typescript --config=p/nodejs --config=p/secrets --error --exclude='**/node_modules/**' --exclude='**/dist/**' --exclude='**/.claude/**' src",
    "check:quick": "pnpm run test",
    "check:dev": "pnpm run typecheck && pnpm run typecheck:etl && pnpm run test",
    "check:related": "pnpm run test:related",
    "check:smart": "node scripts/test/check-smart.mjs",
    "check:staged": "node scripts/test/check-smart.mjs --staged",
    "typecheck": "pnpm run artifacts:link && tsc --build --pretty false",
    "typecheck:etl": "pnpm run artifacts:link && tsc --noEmit --pretty false -p tsconfig.etl.json",
    "domain:orphans": "tsx scripts/find-domain-orphans.ts",
    "contracts:http": "node --import tsx scripts/export-http-contract-manifest.ts",
    "verify:http-contracts": "pnpm run contracts:http -- data/http-contract-manifest.json && pnpm run test:meta:file -- src/interface/http/routes/__tests__/http-contract-manifest-script.test.ts && pnpm run test:file -- test/regression/http-contract-catalog-properties.regression.test.ts test/regression/http-route-catalog-server-parity.regression.test.ts && pnpm run test:integration:file -- test/integration/http/routes/route-contract-registry.test.ts test/integration/http/routes/public-query-contracts.test.ts",
    "verify:drinking-window-model": "tsx scripts/verify-drinking-window-model.ts",
    "verify:openai-injection-wiring": "tsx scripts/verify-openai-injection-wiring.ts",
    "verify:anthropic-wiring": "tsx scripts/verify-anthropic-wiring.ts",
    "verify:all": "pnpm run verify:anthropic-wiring && pnpm run verify:openai-injection-wiring && pnpm run verify:drinking-window-model && pnpm run verify:http-contracts",
    "verify:security-local": "pnpm run verify:openai-injection-wiring && pnpm run semgrep",
    "calibrate:resolver": "tsx --env-file=.env scripts/calibrate/fit-resolver-calibration.ts",
    "calibrate:resolver:dry": "tsx --env-file=.env scripts/calibrate/fit-resolver-calibration.ts --dry-run",
    "eval": "tsx scripts/eval/run-offline-eval.ts",
    "eval:offline:local": "tsx scripts/eval/run-offline-eval-local.ts",
    "eval:offline:gate": "tsx scripts/eval/run-offline-eval.ts --fixture-corpus gate --tier gate --verify-splits",
    "eval:offline:silver": "tsx scripts/eval/run-offline-eval.ts --fixture-corpus silver --tier silver --output data/eval-results-silver.json",
    "eval:offline:with-splits": "tsx scripts/eval/run-offline-eval.ts --fixture-corpus gate --tier gate --verify-splits",
    "eval:offline:with-splits:local": "tsx scripts/eval/run-offline-eval-local.ts --verify-splits",
    "eval:offline:smoke:local": "tsx scripts/eval/run-offline-eval-local.ts --input data/eval-smoke-queries.jsonl --output /tmp/offline-eval-smoke-local-results.json --tier bronze",
    "eval:full": "pnpm run eval:offline:gate && pnpm run test:verification:noisy && pnpm run eval:fixtures:verify && pnpm run eval:claim:bootstrap",
    "eval:sota:parallel": "bash scripts/eval/run-sota-parallel.sh",
    "eval:offline:bronze": "tsx scripts/eval/run-offline-eval.ts --fixture-corpus silver --tier bronze --allow-local-threshold-fallback --output data/eval-results-bronze.json",
    "eval:offline:assert-baseline": "tsx scripts/eval/assert-baseline-regression.ts --kind offline --current data/eval-results.json",
    "eval:offline:smoke": "tsx scripts/eval/run-offline-eval-smoke.ts --tier bronze --input data/eval-smoke-queries.jsonl --output /tmp/offline-eval-smoke-results.json",
    "eval:offline:smoke:assert-baseline": "pnpm run eval:offline:smoke && tsx scripts/eval/assert-baseline-regression.ts --kind offline --current /tmp/offline-eval-smoke-results.json --baseline data/eval-baselines/offline-smoke-v1.json",
    "eval:offline:smoke:with-baseline": "tsx scripts/eval/run-offline-eval-smoke.ts --tier bronze --input data/eval-smoke-queries.jsonl --output /tmp/offline-eval-smoke-results.json --baseline-report data/eval-baselines/offline-smoke-v1.json",
    "eval:offline:smoke:refresh-baseline": "pnpm run eval:offline:smoke:with-baseline && cp /tmp/offline-eval-smoke-results.json data/eval-baselines/offline-smoke-v1.json",
    "eval:offline:embedding:build-corpus": "tsx scripts/eval/build-embedding-sensitive-human-gold-corpus.ts --output /tmp/embedding-sensitive-human-gold-corpus.jsonl",
    "eval:offline:embedding": "tsx scripts/eval/run-offline-eval-embedding-sensitive.ts",
    "eval:offline:embedding:ablation": "tsx scripts/eval/run-offline-eval-embedding-sensitive.ts --compare-dense-off",
    "eval:offline:embedding:isolated": "tsx scripts/eval/run-offline-eval-embedding-sensitive-isolated.ts",
    "eval:offline:embedding:isolated:ablation": "tsx scripts/eval/run-offline-eval-embedding-sensitive-isolated.ts --compare-dense-off",
    "eval:claim:bootstrap": "tsx scripts/eval/analyze-legacy-claim-bootstrap.ts --out /tmp/legacy-claim-bootstrap-analysis.json",
    "eval:noisy": "node --import tsx scripts/eval/run-noisy-entity-eval.ts",
    "eval:noisy:smoke": "node --import tsx scripts/eval/run-noisy-entity-eval.ts --smoke-predictions --output data/noisy-entity-eval-smoke-results.json",
    "eval:noisy:validate": "node --import tsx scripts/eval/run-noisy-entity-eval.ts --smoke-predictions --output /tmp/noisy-entity-eval-results.json",
    "eval:noisy:gate": "node --import tsx scripts/eval/run-noisy-entity-eval.ts --smoke-predictions --output /tmp/noisy-entity-eval-results.json --min-recall-at-3 1 --enforce-min-recall-at-3-by-category --enforce-min-recall-at-3-by-language --min-resolution-match-rate 1 --min-provenance-match-rate 1 --max-false-exact-rate 0",
    "eval:entity:fixtures": "tsx scripts/eval/run-entity-retrieval-fixture-eval.ts --smoke-predictions",
    "eval:entity:fixtures:live": "tsx scripts/eval/run-entity-retrieval-fixture-eval.ts",
    "eval:lookup-v2:authority": "node --import tsx scripts/eval/run-entity-resolution-validation.ts --use-active-runtime",
    "eval:lookup-v2:verify-active-runtime-semantic-scope-target-parity": "node --import tsx scripts/eval/verify-lookup-v2-active-runtime-semantic-scope-target-parity.ts",
    "eval:lookup-v2:parity": "node --import tsx scripts/eval/run-lookup-v2-parity.ts --use-active-runtime",
    "eval:lookup-v2:coverage": "node --import tsx scripts/eval/run-lookup-v2-coverage-report.ts --use-active-runtime",
    "eval:lookup-v2:latency:korean-famous": "node --import tsx scripts/eval/run-lookup-v2-latency-korean-famous.ts --use-active-runtime",
    "eval:lookup-v2:canary:build": "node --import tsx scripts/eval/build-lookup-v2-canary-corpus.ts",
    "eval:lookup-v2:canary:replay": "node --import tsx scripts/eval/run-lookup-v2-canary-replay.ts",
    "eval:lookup-v2:parity:korean-famous": "node --import tsx scripts/eval/run-lookup-v2-parity.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-famous-expanded.jsonl --output /tmp/lookup-v2-parity-korean-famous.json",
    "eval:lookup-v2:coverage:korean-famous": "node --import tsx scripts/eval/run-lookup-v2-coverage-report.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-famous-expanded.jsonl --output /tmp/lookup-v2-coverage-korean-famous.json",
    "eval:lookup-v2:parity:korean-realworld-stretch": "node --import tsx scripts/eval/run-lookup-v2-parity.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --output /tmp/lookup-v2-parity-korean-realworld-stretch.json",
    "eval:lookup-v2:parity:korean-realworld-stretch:entity-only": "node --import tsx scripts/eval/run-lookup-v2-parity.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --partition entity-only --output /tmp/lookup-v2-parity-korean-realworld-stretch-entity-only.json",
    "eval:lookup-v2:parity:korean-realworld-stretch:entity-no-policy": "node --import tsx scripts/eval/run-lookup-v2-parity.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --partition entity-no-policy --output /tmp/lookup-v2-parity-korean-realworld-stretch-entity-no-policy.json",
    "eval:lookup-v2:parity:korean-realworld-stretch:discovery-only": "node --import tsx scripts/eval/run-lookup-v2-parity.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --partition discovery-only --output /tmp/lookup-v2-parity-korean-realworld-stretch-discovery-only.json",
    "eval:lookup-v2:parity:korean-realworld-stretch:policy-conflict": "node --import tsx scripts/eval/run-lookup-v2-parity.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --partition policy-conflict --output /tmp/lookup-v2-parity-korean-realworld-stretch-policy-conflict.json",
    "eval:lookup-v2:coverage:korean-realworld-stretch": "node --import tsx scripts/eval/run-lookup-v2-coverage-report.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --output /tmp/lookup-v2-coverage-korean-realworld-stretch.json",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-only": "node --import tsx scripts/eval/run-lookup-v2-coverage-report.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --partition entity-only --output /tmp/lookup-v2-coverage-korean-realworld-stretch-entity-only.json",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy": "node --import tsx scripts/eval/run-lookup-v2-coverage-report.ts --use-active-runtime --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --partition entity-no-policy --output /tmp/lookup-v2-coverage-korean-realworld-stretch-entity-no-policy.json",
    "eval:lookup-v2:stretch:report": "node --import tsx scripts/eval/report-lookup-v2-stretch-corpus.ts --input test/fixtures/lookup-v2-korean-realworld-stretch.jsonl",
    "eval:lookup-v2:stretch:build-expansion-prompt": "node --import tsx scripts/eval/build-lookup-v2-stretch-expansion-prompt.ts --input test/fixtures/lookup-v2-korean-realworld-stretch.jsonl --output /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-expansion-prompt.txt",
    "eval:lookup-v2:stretch:merge-candidate": "node --import tsx scripts/eval/merge-lookup-v2-stretch-candidate.ts --corpus test/fixtures/lookup-v2-korean-realworld-stretch.jsonl",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:refresh-write-plane": "node --import tsx scripts/eval/refresh-lookup-v2-stretch-write-plane.ts --input /tmp/lookup-v2-coverage-korean-realworld-stretch-entity-no-policy.json --outputDir /tmp/lookup-v2-drafts",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:sync-localized-scope-surfaces": "node --import tsx scripts/eval/sync-lookup-v2-localized-scope-surface-registry-from-draft.ts --input /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-entity-no-policy-draft.jsonl --write",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:verify-reviewed-registry-overlay": "node --import tsx scripts/eval/verify-lookup-v2-stretch-reviewed-registry-overlay.ts --input /tmp/lookup-v2-coverage-korean-realworld-stretch-entity-no-policy.json --workDir /tmp/lookup-v2-drafts --baselineOutputDir /tmp/lookup-v2-drafts --overlayOutputDir /tmp/lookup-v2-drafts --output /tmp/lookup-v2-drafts/lookup-v2-stretch-reviewed-registry-overlay-summary.json",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:verify-scope-support-overlay": "node --import tsx scripts/eval/verify-lookup-v2-stretch-reviewed-registry-overlay.ts --input /tmp/lookup-v2-coverage-korean-realworld-stretch-entity-no-policy.json --baselineSemanticScopeSupportRegistry /tmp/lookup-v2-empty-semantic-scope-support-registry.jsonl --workDir /tmp/lookup-v2-support-overlay-proof --baselineOutputDir /tmp/lookup-v2-support-overlay-proof/baseline --overlayOutputDir /tmp/lookup-v2-support-overlay-proof/overlay --output /tmp/lookup-v2-drafts/lookup-v2-stretch-reviewed-registry-overlay-summary.json",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:verify-family-collision-overlay": "node --import tsx scripts/eval/verify-lookup-v2-stretch-reviewed-registry-overlay.ts --input /tmp/lookup-v2-coverage-korean-realworld-stretch-entity-no-policy.json --baselineFamilyCollisionRegistry /tmp/lookup-v2-empty-family-collision-registry.jsonl --workDir /tmp/lookup-v2-collision-overlay-proof --baselineOutputDir /tmp/lookup-v2-collision-overlay-proof/baseline --overlayOutputDir /tmp/lookup-v2-collision-overlay-proof/overlay --output /tmp/lookup-v2-drafts/lookup-v2-stretch-reviewed-registry-overlay-summary.json",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:export-draft": "node --import tsx scripts/eval/export-lookup-v2-curation-drafts.ts --input /tmp/lookup-v2-coverage-korean-realworld-stretch-entity-no-policy.json --output /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-entity-no-policy-draft.jsonl",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:export-exact-safe-packet": "node --import tsx scripts/eval/export-lookup-v2-exact-safe-proposal-packet.ts --input /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-entity-no-policy-draft.jsonl --output /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-auto-targetable-exact-safe-proposals.jsonl",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:approve-reviewed-authority-exact-safe-packet": "node --import tsx scripts/eval/approve-lookup-v2-reviewed-authority-exact-safe-proposal-packet.ts --input /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-auto-targetable-exact-safe-proposals.jsonl --output /tmp/lookup-v2-reviewed-authority-exact-safe-proposals-approved.jsonl",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:export-exact-safe-family-review-packet": "node --import tsx scripts/eval/export-lookup-v2-exact-safe-family-review-packet.ts --input /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-auto-targetable-exact-safe-proposals.jsonl --output /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-exact-safe-family-review-packet.jsonl",
    "eval:lookup-v2:coverage:korean-realworld-stretch:entity-no-policy:export-exact-safe-family-suggestions": "node --import tsx scripts/eval/export-lookup-v2-exact-safe-family-suggestions.ts --input /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-exact-safe-family-review-packet.jsonl --output /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-exact-safe-family-suggestions.jsonl --decisionsOutput /tmp/lookup-v2-drafts/lookup-v2-korean-realworld-stretch-exact-safe-family.suggested-decisions.jsonl",
