{
  "name": "wine-search-engine",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "artifacts:link": "bash scripts/build/link-external-artifacts.sh",
    "deadcode": "knip --no-exit-code",
    "dev": "tsx watch src/main.ts",
    "build": "npm run artifacts:link && tsc --project tsconfig.build.json --pretty false",
    "start": "node dist/main.js",
    "test": "vitest run --config config/vitest/dev.config.ts",
    "test:watch": "vitest --config config/vitest/dev.config.ts",
    "test:dev": "vitest run --config config/vitest/dev.config.ts",
    "test:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/dev.config.ts",
    "test:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/dev.config.ts",
    "test:eval": "vitest run --config config/vitest/eval.config.ts",
    "test:eval:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/eval.config.ts",
    "test:meta": "vitest run --config config/vitest/meta.config.ts",
    "test:meta:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/meta.config.ts",
    "test:unit": "vitest run --config config/vitest/unit.config.ts",
    "test:unit:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/unit.config.ts",
    "test:unit:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/unit.config.ts",
    "test:heavy": "vitest run --config config/vitest/heavy.config.ts",
    "test:network": "vitest run --config config/vitest/network.config.ts",
    "test:coverage": "npm run artifacts:link && mkdir -p coverage/.tmp && vitest run --config config/vitest/unit.config.ts --coverage",
    "test:integration": "vitest run --config config/vitest/integration.config.ts",
    "test:integration:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/integration.config.ts",
    "test:integration:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/integration.config.ts",
    "test:integration:search-pipeline": "vitest run --config config/vitest/integration.search-pipeline.config.ts",
    "test:watchlist": "vitest run --config config/vitest/watchlist.config.ts",
    "test:watchlist:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/watchlist.config.ts",
    "test:watchlist:pg": "vitest run test/integration/watchlist/pg-watchlist-store.integration.test.ts",
    "test:e2e": "npm run test:e2e:contract",
    "test:e2e:fast": "npm run test:e2e:contract",
    "test:e2e:file": "node scripts/test/run-vitest-lane.mjs run config/vitest/e2e.config.ts",
    "test:e2e:related": "node scripts/test/run-vitest-lane.mjs related config/vitest/e2e.config.ts",
    "test:e2e:runtime": "vitest run --config config/vitest/e2e.runtime.config.ts",
    "test:e2e:inmemory": "vitest run --config config/vitest/e2e.config.ts",
    "test:e2e:contract": "vitest run --config config/vitest/e2e.smoke.config.ts",
    "test:e2e:smoke": "npm run test:e2e:contract",
    "test:e2e:full": "npm run test:e2e:contract && npm run test:e2e:runtime && npm run test:e2e:inmemory",
    "test:e2e:replay:fixtures:self-contained": "vitest run --config config/vitest/e2e.replay.config.ts",
    "test:e2e:replay:fixtures:runtime-required": "vitest run test/e2e/search-replay-runtime-required-fixtures.test.ts --config config/vitest/e2e.replay.config.ts",
    "test:e2e:replay:fixtures:full-runtime": "bash scripts/run-vespa-test-lane.sh npx vitest run test/e2e/vespa/search-replay-full-runtime-fixtures.test.ts --config config/vitest/e2e.vespa.config.ts",
    "test:e2e:replay:fixtures:full-runtime:debug": "bash scripts/run-vespa-test-lane.sh npx vitest run test/e2e/vespa/search-replay-full-runtime-fixtures.test.ts --config config/vitest/e2e.vespa.config.ts --reporter=verbose",
    "test:e2e:vespa": "npm run test:e2e:vespa:full",
    "test:e2e:vespa:smoke": "bash scripts/run-vespa-test-lane.sh npx vitest run --config config/vitest/e2e.vespa.smoke.config.ts --reporter=verbose",
    "test:e2e:vespa:smoke:dev": "VESPA_URL=http://localhost:8080 npx vitest run --config config/vitest/e2e.vespa.smoke.config.ts --reporter=verbose",
    "test:e2e:vespa:full": "bash scripts/run-vespa-e2e.sh",
    "test:e2e:vespa:setup": "bash scripts/setup-vespa-test.sh",
    "test:e2e:vespa:teardown": "bash scripts/teardown-vespa-test.sh",
    "test:e2e:vespa:only": "bash scripts/run-vespa-test-lane.sh npx vitest --config config/vitest/e2e.vespa.config.ts --reporter=verbose",
    "test:e2e:vespa:network": "bash scripts/run-vespa-test-lane.sh npx vitest run test/e2e/vespa/search-network-services.test.ts --config config/vitest/e2e.vespa.config.ts --reporter=verbose",
    "test:ingest:contract": "vitest run --config config/vitest/ingest.contract.config.ts",
    "test:ingest:indexing": "bash scripts/run-vespa-test-lane.sh npx tsx scripts/etl/run-ingest-indexing-smoke.ts",
    "test:quality": "vitest run --config config/vitest/quality.config.ts && npm run eval:noisy:validate",
    "test:quality:nightly": "npm run test:quality && npm run eval:noisy:assert-baseline:current",
    "test:quality:vespa": "bash scripts/run-vespa-test-lane.sh npx vitest run --config config/vitest/quality.vespa.config.ts",
    "bench:smoke": "npx tsx test/benchmark/agent/smoke.ts",
    "bench:run": "npx tsx test/benchmark/agent/runner.ts --profile standard",
    "bench:agent": "npx tsx test/benchmark/agent/runner.ts",
    "bench:agent:tier": "npx tsx test/benchmark/agent/runner.ts --tier",
    "benchmark:quick": "npx tsx test/benchmark/agent/runner.ts --profile quick",
    "benchmark:standard": "npx tsx test/benchmark/agent/runner.ts --profile standard --no-judge",
    "benchmark:nightly": "npx tsx test/benchmark/agent/runner.ts --profile nightly",
    "benchmark:retrieval": "tsx test/benchmark/agent/retrieval-runner.ts --profile retrieval",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:watchlist && npm run test:meta && npm run test:e2e:contract && npm run test:ingest:contract && npm run test:quality",
    "test:all:full": "npm run test:all && npm run test:heavy && npm run test:e2e:runtime",
    "test:verification:vespa": "bash scripts/run-vespa-verification.sh",
    "lint": "eslint .",
    "lint:file": "node scripts/test/run-eslint.mjs",
    "lint:file:fix": "node scripts/test/run-eslint.mjs --fix --max-warnings=0",
    "lint:smart": "node scripts/test/lint-smart.mjs",
    "lint:staged": "node scripts/test/lint-smart.mjs --staged",
    "lint:fix": "eslint . --fix",
    "semgrep": "semgrep scan --metrics=off --config=semgrep/wine-rules.yml --config=p/ci --config=p/typescript --config=p/nodejs --config=p/secrets --error --exclude='**/node_modules/**' --exclude='**/dist/**' --exclude='**/.claude/**' src",
    "check:quick": "npm run test",
    "check:dev": "npm run typecheck && npm run test",
    "check:related": "npm run test:related",
    "check:smart": "node scripts/test/check-smart.mjs",
    "check:staged": "node scripts/test/check-smart.mjs --staged",
    "typecheck": "npm run artifacts:link && tsc --noEmit --pretty false",
    "domain:orphans": "tsx scripts/find-domain-orphans.ts",
    "feedback:prune-ttl": "tsx scripts/prune-feedback-ttl.ts",
    "contracts:http": "tsx scripts/export-http-contract-manifest.ts",
    "contracts:http:openapi-bridge": "tsx scripts/export-http-openapi-bridge.ts",
    "verify:http-contracts": "vitest run --config config/vitest/unit.config.ts test/unit/interface/http/http-route-catalog-openapi-parity.test.ts",
    "verify:drinking-window-model": "tsx scripts/verify-drinking-window-model.ts",
    "verify:anthropic-wiring": "tsx scripts/verify-anthropic-wiring.ts",
    "verify:security-local": "npm run verify:anthropic-wiring && npm run semgrep",
    "eval": "tsx scripts/eval/run-offline-eval.ts",
    "eval:offline:local": "tsx scripts/eval/run-offline-eval-local.ts",
    "eval:offline:with-splits": "tsx scripts/eval/run-offline-eval.ts --verify-splits",
    "eval:offline:with-splits:local": "tsx scripts/eval/run-offline-eval-local.ts --verify-splits",
    "eval:offline:smoke:local": "tsx scripts/eval/run-offline-eval-local.ts --input data/eval-smoke-queries.jsonl --output /tmp/offline-eval-smoke-local-results.json --tier bronze",
    "eval:full": "tsx scripts/eval/run-offline-eval.ts --verify-splits --tier bronze --output data/eval-results.json",
    "eval:sota:parallel": "bash scripts/eval/run-sota-parallel.sh",
    "eval:offline:bronze": "tsx scripts/eval/run-offline-eval.ts --tier bronze --output data/eval-results.json",
    "eval:offline:assert-baseline": "tsx scripts/eval/assert-baseline-regression.ts --kind offline --current data/eval-results.json",
    "eval:offline:smoke": "tsx scripts/eval/run-offline-eval-smoke.ts --tier bronze --input data/eval-smoke-queries.jsonl --output /tmp/offline-eval-smoke-results.json",
    "eval:offline:smoke:assert-baseline": "npm run eval:offline:smoke && tsx scripts/eval/assert-baseline-regression.ts --kind offline --current /tmp/offline-eval-smoke-results.json --baseline data/eval-baselines/offline-smoke-v1.json",
    "eval:offline:smoke:with-baseline": "tsx scripts/eval/run-offline-eval-smoke.ts --tier bronze --input data/eval-smoke-queries.jsonl --output /tmp/offline-eval-smoke-results.json --baseline-report data/eval-baselines/offline-smoke-v1.json",
    "eval:offline:smoke:refresh-baseline": "npm run eval:offline:smoke:with-baseline && cp /tmp/offline-eval-smoke-results.json data/eval-baselines/offline-smoke-v1.json",
    "eval:noisy": "tsx scripts/eval/run-noisy-entity-eval.ts",
    "eval:noisy:smoke": "tsx scripts/eval/run-noisy-entity-eval.ts --predictions data/noisy-entity-predictions-smoke.jsonl --output data/noisy-entity-eval-smoke-results.json",
    "eval:noisy:validate": "tsx scripts/eval/run-noisy-entity-eval.ts --predictions data/noisy-entity-predictions-smoke.jsonl --output /tmp/noisy-entity-eval-results.json",
    "eval:noisy:gate": "tsx scripts/eval/run-noisy-entity-eval.ts --predictions data/noisy-entity-predictions-smoke.jsonl --output /tmp/noisy-entity-eval-results.json --min-recall-at-3 1 --min-resolution-match-rate 1 --min-provenance-match-rate 1 --max-false-exact-rate 0",
    "eval:noisy:assert-baseline:current": "tsx scripts/eval/assert-baseline-regression.ts --kind noisy --current /tmp/noisy-entity-eval-results.json",
    "eval:noisy:assert-baseline": "npm run eval:noisy:validate && npm run eval:noisy:assert-baseline:current",
    "eval:noisy:refresh-baseline": "tsx scripts/eval/run-noisy-entity-eval.ts --predictions data/noisy-entity-predictions-smoke.jsonl --output data/eval-baselines/noisy-entity-smoke-v1.json",
    "eval:fixtures:verify": "tsx scripts/eval/verify-external-fixture-governance.ts",
    "test:verification:noisy": "npm run eval:noisy:gate && npm run eval:noisy:assert-baseline:current",
    "test:verification:fixtures": "npm run eval:fixtures:verify",
    "test:verification:core": "npm run typecheck && npm run test:e2e:contract && npm run test:e2e:runtime && npm run test:ingest:contract && npm run test:verification:noisy",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap:smoke": "bash scripts/bootstrap-smoke.sh",
    "vivino:bronze": "tsx tools/bronze-vivino-data-connector/fetch-vivino-snapshots.ts",
    "finetuning:prepare": "tsx scripts/fine-tune/prepare-finetuning-data.ts",
    "etl:transliteration": "tsx scripts/etl/generate-transliteration-aliases.ts",
    "etl:silver": "tsx scripts/etl/vivino-to-silver.ts",
    "etl:track-c": "tsx scripts/etl/run-track-c.ts",
    "etl:validate": "tsx scripts/etl/validate-silver.ts",
    "etl:index": "tsx scripts/etl/index-to-vespa.ts",
    "etl:full": "npm run etl:silver && npm run etl:track-c && npm run etl:validate && npm run etl:index",
    "prepare": "husky",
    "check:security-patterns": "node scripts/test/check-security-patterns.mjs",
    "check:ci": "npm run typecheck && npm run check:security-patterns && npm run test:unit && npm run verify:http-contracts && npm run deadcode",
    "git:prepush": "npm run typecheck && npm run check:security-patterns && npm run test:unit && npm run verify:http-contracts",
    "git:prepush:smart": "node scripts/test/prepush-smart.mjs",
    "git:prepush:quick": "npm run typecheck && npm run test:unit",
    "git:prepush:heavy": "npm run typecheck && npm run test:unit && npm run verify:http-contracts && npm run test:heavy",
    "dev:full": "concurrently --names \"api,web\" --prefix-colors \"magenta,cyan\" \"REDIS_URL=redis://localhost:6379 PORT=4000 npm run dev\" \"cd web && NEXT_PUBLIC_API_URL=http://localhost:4000 npm run dev\""
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run lint:file:fix --"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.2.0",
    "nanoid": "^5.1.0",
    "onnxruntime-node": "^1.22.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "redis": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "knip": "^6.3.1",
    "lint-staged": "^16.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.0.0"
  }
}
