{
  "name": "wine-search-engine",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/interface/http/server.js",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watchlist:pg": "vitest run test/integration/watchlist/pg-watchlist-store.integration.test.ts",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "test:e2e:smoke": "vitest run --config vitest.e2e.smoke.config.ts",
    "test:e2e:full": "vitest run --config ./vitest.e2e.config.ts",
    "test:e2e:vespa": "bash scripts/run-vespa-e2e.sh",
    "test:e2e:vespa:setup": "bash scripts/setup-vespa-test.sh",
    "test:e2e:vespa:teardown": "bash scripts/teardown-vespa-test.sh",
    "test:e2e:vespa:only": "VESPA_URL=http://localhost:18080 vitest --config vitest.e2e.vespa.config.ts",
    "test:quality": "vitest run --config vitest.quality.config.ts && npm run eval:noisy:validate",
    "test:quality:vespa": "VESPA_URL=http://localhost:18080 vitest run --config vitest.quality.vespa.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e:smoke && npm run test:e2e:full && npm run test:quality",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "semgrep": "semgrep scan --metrics=off --config=semgrep/wine-rules.yml --config=p/ci --config=p/typescript --config=p/nodejs --config=p/secrets --error --exclude='**/node_modules/**' --exclude='**/dist/**' --exclude='**/.claude/**' src",
    "typecheck": "tsc --noEmit --incremental false",
    "contracts:http": "tsx scripts/export-http-contract-manifest.ts",
    "eval": "tsx scripts/eval/run-offline-eval.ts",
    "eval:noisy": "tsx scripts/eval/run-noisy-entity-eval.ts",
    "eval:noisy:smoke": "tsx scripts/eval/run-noisy-entity-eval.ts --predictions data/noisy-entity-predictions-smoke.jsonl --output data/noisy-entity-eval-smoke-results.json",
    "eval:noisy:validate": "tsx scripts/eval/run-noisy-entity-eval.ts --predictions data/noisy-entity-predictions-smoke.jsonl --output /tmp/noisy-entity-eval-results.json",
    "ingest": "tsx src/interface/cli/ingest.command.ts",
    "kill-switch": "tsx src/interface/cli/kill-switch.command.ts",
    "migrate": "node --experimental-vm-modules scripts/migrate.ts",
    "vivino:bronze": "tsx tools/bronze-vivino-data-connector/fetch-vivino-snapshots.ts",
    "finetuning:prepare": "tsx scripts/fine-tune/prepare-finetuning-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@fastify/rate-limit": "^10.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.2.0",
    "nanoid": "^5.1.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "redis": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.0.0"
  }
}
