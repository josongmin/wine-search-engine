web/node_modules/
dist
dist/
coverage
coverage/
.next/
web/.next/
.turbo/
.cache/
.tmp/
tmp/
temp/
*.tsbuildinfo
next-env.d.ts
test-results
test-results/
playwright-report
playwright-report/
*.log

