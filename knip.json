{
  "ignoreUnresolved": [
    "embedding-service\\.js$",
    "reranker\\.js$"
  ],
  "ignoreIssues": {
    "src/infrastructure/db/pg-pool.ts": ["exports"],
    "src/domain/shared/utils/data-paths.ts": ["exports"],
    "test/benchmark/agent/scorer.ts": ["exports", "types"],
    "test/benchmark/agent/scorer-*.ts": ["exports", "types"],
    "src/domain/retrieval/service/hyde-generator.ts": ["exports", "types"],
    "src/domain/retrieval/service/multi-query-generator.ts": ["exports", "types"],
    "src/domain/retrieval/service/constraint-validator.ts": ["types"]
  },
  "typescript": true,
  "vitest": true,
  "workspaces": {
    ".": {
      "entry": [
        "config/vitest/*.config.ts",
        "scripts/**/*.ts",
        "test/**/*.test.ts",
        "src/**/*.test.ts",
        "src/**/__tests__/**/*.test.ts",
        "test/benchmark/agent/constraint-extraction-eval.ts",
        "test/benchmark/wine-search/runner.ts",
        "test/benchmark/agent/scenarios.robustness.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "test/**/*.{ts,tsx}",
        "config/**/*.ts"
      ],
      "ignoreBinaries": [
        "semgrep",
        "concurrently"
      ]
    },
    "web": {
      "next": true,
      "postcss": true,
      "tailwind": true,
      "typescript": true,
      "vitest": true,
      "entry": [
        "src/app/**/*.{ts,tsx,css}",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
