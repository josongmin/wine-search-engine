schema wine_entity {
  document wine_entity {
    field entity_id type string {
      indexing: summary | attribute
    }
    field entity_type type string {
      indexing: summary | attribute
    }
    field canonical_label type string {
      indexing: summary | attribute | index
    }
    field aliases_identity_safe type array<string> {
      indexing: summary | attribute | index
    }
    field aliases_noisy_recall type array<string> {
      indexing: summary | attribute | index
    }
    field producer type string {
      indexing: summary | attribute | index
    }
    field region type string {
      indexing: summary | attribute
    }
    field grapes type array<string> {
      indexing: summary | attribute
    }
    field search_text_ko type string {
      indexing: summary | index
      language: ko
    }
    field search_text_en type string {
      indexing: summary | index
      language: en
    }
    field semantic_summary type string {
      indexing: summary
    }
    field body type float {
      indexing: summary | attribute
    }
    field sweetness type float {
      indexing: summary | attribute
    }
    field style type string {
      indexing: summary | attribute
    }
    field price_band type string {
      indexing: summary | attribute
    }
    field pairing type array<string> {
      indexing: summary | attribute
    }
    field occasion type array<string> {
      indexing: summary | attribute
    }
    field availability type bool {
      indexing: summary | attribute
    }
    field popularity_score type float {
      indexing: summary | attribute
    }
    field embedding type tensor<float>(x[1024]) {
      indexing: summary | attribute
      attribute {
        distance-metric: angular
      }
    }
    field learned_sparse_weights type tensor<float>(token{}) {
      indexing: summary | attribute
    }

    # ── SOTA++ wine-domain fields ──────────────────────────────────────────────

    field vintage_year type int {
      indexing: summary | attribute
    }
    field wine_type type string {
      indexing: summary | attribute
    }
    field grape_primary type string {
      indexing: summary | attribute
    }
    field country type string {
      indexing: summary | attribute
    }
    field appellation type string {
      indexing: summary | attribute
    }
    field classification type string {
      indexing: summary | attribute
    }
    field acidity type float {
      indexing: summary | attribute
    }
    field tannin type float {
      indexing: summary | attribute
    }
    field finish_length type float {
      indexing: summary | attribute
    }
    field price_usd type float {
      indexing: summary | attribute
    }
    field alcohol_pct type float {
      indexing: summary | attribute
    }
    field critic_score_normalized type float {
      indexing: summary | attribute
    }
    field producer_prestige type float {
      indexing: summary | attribute
    }
    field flavor_profiles type array<string> {
      indexing: summary | attribute
    }
    field certifications type array<string> {
      indexing: summary | attribute
    }
    field drinking_window_start type int {
      indexing: summary | attribute
    }
    field drinking_window_end type int {
      indexing: summary | attribute
    }
    field drinking_window_model_version type string {
      indexing: summary | attribute
    }
    field soil_type type string {
      indexing: summary | attribute
    }
    field producer_type type string {
      indexing: summary | attribute
    }
    field oak_treatment type string {
      indexing: summary | attribute
    }

    # ── Doc2Query synthetic queries (BUG-02 / Doc2Query BM25) ────────────────
    # Generated by ETL pipeline to expand BM25 coverage. Indexed as array<string>
    # so bm25(synthetic_queries) aggregates per-term BM25 across all expansions.

    field synthetic_queries type array<string> {
      indexing: summary | index
    }

    # ── Taxonomy enrichment fields (Epic 12 / Task 5) ─────────────────────────

    field grape_family type string {
      indexing: summary | attribute
    }
    field region_hierarchy type array<string> {
      indexing: summary | attribute
    }
    field price_band_numeric type int {
      indexing: summary | attribute
    }
  }

  fieldset default {
    fields: canonical_label, aliases_identity_safe, search_text_ko, search_text_en, producer
  }

  rank-profile bm25 inherits default {
    first-phase {
      # synthetic_queries weight (0.5): Doc2Query expansions provide auxiliary BM25 signal;
      # lower weight than primary fields to avoid over-indexing generated queries.
      expression: bm25(canonical_label) + bm25(search_text_ko) + bm25(search_text_en) + 0.5 * bm25(synthetic_queries)
    }
  }

  rank-profile semantic inherits default {
    inputs {
      query(query_embedding) tensor<float>(x[1024])
    }
    first-phase {
      expression: closeness(field, embedding)
    }
  }

  rank-profile hybrid inherits default {
    inputs {
      query(query_embedding) tensor<float>(x[1024])
    }
    first-phase {
      expression: 0.5 * bm25(canonical_label) + 0.5 * closeness(field, embedding)
    }
  }

  rank-profile learned_sparse inherits default {
    inputs {
      query(sparse_query_embedding) tensor<float>(token{})
    }
    first-phase {
      expression: dotProduct(learned_sparse_weights, sparse_query_embedding)
    }
  }

  # ── Named document summaries ────────────────────────────────────────────────
  #
  # hit_summary     — All fields consumed by readRawVespaRetrievalSummary()
  #                   (driven by RETRIEVAL_HIT_SUMMARY_KEYS in search-index.port.ts).
  #                   Used by fetchWithHitSummary() in vespa-search-index.ts.
  #                   Must list every key in RETRIEVAL_HIT_SUMMARY_KEYS plus entity_id.
  #
  # feature_summary — Fields consumed by parseFeatureSummary() (ranking / ML only).
  #                   Used by fetchWithFeatureSummary() in vespa-search-index.ts.
  #                   Lean by design — only what the ranker needs at query time.
  #
  # default         — all fields (backward compat; used by existing search paths).
  #
  # Note: entity_id and sensory/critic fields appear in both summaries because
  # both parsers need entity_id and both consumers need body/tannin/acidity/
  # sweetness/drinking-window fields. Vespa allows any field in multiple summaries.
  #
  # IMPORTANT: every field in RETRIEVAL_HIT_SUMMARY_KEYS MUST be listed here.
  # Omitting a field silently drops it from the Vespa named-summary response.

  document-summary hit_summary {
    summary entity_id {}
    summary canonical_label {}
    summary producer {}
    summary region {}
    summary appellation {}
    summary grape_primary {}
    summary vintage_year {}
    summary search_text_en {}
    summary search_text_ko {}
    summary producer_prestige {}
    summary style {}
    summary price_band {}
    summary pairing {}
    summary occasion {}
    summary body {}
    summary tannin {}
    summary acidity {}
    summary sweetness {}
    summary finish_length {}
    summary wine_type {}
    summary critic_score_normalized {}
    summary country {}
    summary classification {}
    summary alcohol_pct {}
    summary drinking_window_start {}
    summary drinking_window_end {}
    summary drinking_window_model_version {}
    summary price_usd {}
    summary certifications {}
    summary soil_type {}
    summary producer_type {}
    summary oak_treatment {}
    summary grape_family {}
    summary region_hierarchy {}
    summary price_band_numeric {}
  }

  document-summary feature_summary {
    summary entity_id {}
    summary body {}
    summary tannin {}
    summary acidity {}
    summary sweetness {}
    summary critic_score_normalized {}
    summary drinking_window_start {}
    summary drinking_window_end {}
    summary drinking_window_model_version {}
  }

  # Prestige-boosted hybrid: for producer_browse / region_browse / compare modes.
  # BM25 is Laplace-normalised (K=25) to [0,1] before blending so it doesn't
  # dwarf the [0,1]-bounded critic and prestige signals.
  # critic_score_normalized and producer_prestige default to 0 when absent.
  rank-profile prestige_hybrid inherits default {
    inputs {
      query(query_embedding) tensor<float>(x[1024])
    }
    first-phase {
      expression:
        0.40 * (0.5 * (bm25(canonical_label) / (bm25(canonical_label) + 25)) + 0.5 * closeness(field, embedding))
        + 0.35 * if(isNan(attribute(critic_score_normalized)), 0, attribute(critic_score_normalized))
        + 0.25 * if(isNan(attribute(producer_prestige)), 0, attribute(producer_prestige))
    }
  }

  # Popularity-native rank: popularity_score is [0,1]; BM25 tiebreaker also
  # Laplace-normalised so it stays within the same scale.
  rank-profile popularity_native inherits default {
    first-phase {
      expression: popularity_score + 0.05 * (bm25(canonical_label) / (bm25(canonical_label) + 25))
    }
  }
}
