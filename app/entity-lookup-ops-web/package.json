{
  "name": "entity-lookup-ops-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone CSR ops console for the lookup-v2 entity-resolution curation pipeline (coverage triage, wine onboarding, disambiguation, drift monitor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5311",
    "sync-data": "bash scripts/sync-data.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
