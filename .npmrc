# Content-addressed store outside the clone (hard-linked into node_modules).
# https://pnpm.io/npmrc#store-dir
store-dir=${HOME}/.wine-search-engine/store/pnpm
#
# Root uses Vitest 3; `web/` uses Vitest 4 + Vite plugin peers aligned with Next —
# strict peers would block a single install tree. Hoisting is not required; this
# only relaxes peer resolution at install time.
strict-peer-dependencies=false
